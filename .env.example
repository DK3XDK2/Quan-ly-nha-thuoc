# ===================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - HỆ THỐNG NHÀ THUỐC AINA PHARMACY
# Sao chép file này thành .env trong thư mục backend để cấu hình
# ===================================================================

# 1. Kết nối Cơ sở dữ liệu MySQL (Prisma ORM)
# Cú pháp: mysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL="mysql://root:root@localhost:3306/ql_thuoc_dev"

# 2. Cổng dịch vụ Backend REST API
CONG_SERVER=4000

# 3. Khóa bí mật mã hóa JWT (JSON Web Token)
KHOA_BI_MAT_JWT="unkown"

# 4. Tích hợp Trí tuệ nhân tạo (AI Assistant)
GEMINI_API_KEY="your_google_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# 5. Tích hợp Cổng thanh toán (Tùy chọn - SePay QR Code)
SEPAY_MERCHANT_ID="SP-EXAMPLE-MERCHANT"
SEPAY_SECRET_KEY="spsk_live_example_key"
SEPAY_ENV="SANDBOX"
SEPAY_API_TOKEN="your_sepay_api_token_here"
BANK_ID="VietinBank"
BANK_ACCOUNT_NO="unkown"
BANK_ACCOUNT_NAME="unkown"
